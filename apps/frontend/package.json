{
  "name": "@dsh-desktop/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
