  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
