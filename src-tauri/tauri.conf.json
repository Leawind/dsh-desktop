{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "identifier": "io.github.leawind.dsh-desktop",
  "build": {
    "beforeDevCommand": "pnpm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run frontend:build",
    "frontendDist": "../apps/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http: https: data: blob:; style-src 'self' 'unsafe-inline'; frame-src http: https:",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
